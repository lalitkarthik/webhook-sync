# Copy to .env on your own machine and fill in. .env is git-ignored.
# In a Claude Code cloud session there is no .env: put the same names in the
# cloud environment's "Environment variables" box instead (docs/agents/cloud.md).
# Test-mode values only. Never a live key.

# Razorpay, test mode (Dashboard > Account & Settings > API keys; Webhooks)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Sheets: the service account's JSON key, base64-encoded so it is one
# plain line (run: python scripts/set_env.py google <downloaded key file>),
# and the id of the throwaway spreadsheet shared with that service account.
GOOGLE_SERVICE_ACCOUNT_B64=
SHEET_ID=

# Research only (optional): lets agents use the Firecrawl CLI.
FIRECRAWL_API_KEY=
